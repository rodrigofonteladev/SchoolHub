# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Seed admin user
SeedAdminUser__UserName=admin
SeedAdminUser__Email=admin@schoolhub.edu.pe
SeedAdminUser__Password=Admin123!

# SQL Server
ConnectionStrings__ConnectionSQL="Server=localhost;Database=SchoolHubDb;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True"

# SMTP / Gmail
SmtpSettings__Server=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__SenderName="SchoolHub Platform"
SmtpSettings__SenderEmail=your-email@gmail.com
SmtpSettings__Username=your-email@gmail.com
SmtpSettings__Password=your-app-password

# Payment amounts
PaymentSettings__EnrollmentAmount=410.00
PaymentSettings__PensionAmount=400.00
PaymentSettings__PensionInstallments=10
PaymentSettings__Currency=PEN

# Mercado Pago
MercadoPagoSettings__AccessToken=ACCESS_TOKEN
MercadoPagoSettings__BaseUrl=https://api.mercadopago.com/
MercadoPagoSettings__PublicBaseUrl=https://your-public-domain.example.com
MercadoPagoSettings__UseSandbox=true
MercadoPagoSettings__WebhookSecret=WEBHOOK_SECRET
