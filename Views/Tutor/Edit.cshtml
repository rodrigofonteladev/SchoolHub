@model SchoolHub.Models.ViewModels.Tutor.RegisterTutorViewModel
<div class="container"><h1 class="title is-2">Edit Tutor</h1><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="columns is-multiline"><div class="column is-6"><label asp-for="FullName" class="label"></label><input asp-for="FullName" class="input"/></div><div class="column is-6"><label asp-for="PaternalSurname" class="label"></label><input asp-for="PaternalSurname" class="input"/></div><div class="column is-6"><label asp-for="MaternalSurname" class="label"></label><input asp-for="MaternalSurname" class="input"/></div><div class="column is-6"><label asp-for="DocumentNumber" class="label"></label><input asp-for="DocumentNumber" class="input"/></div><div class="column is-6"><label asp-for="DocumentTypeId" class="label"></label><div class="select is-fullwidth"><select asp-for="DocumentTypeId" asp-items="Model.DocumentTypes"><option value="">Select a document type</option></select></div></div><div class="column is-6"><label asp-for="Relationship" class="label"></label><div class="select is-fullwidth"><select asp-for="Relationship" asp-items="Html.GetEnumSelectList<SchoolHub.Common.Enums.TutorType>()"><option value="">Select a relationship</option></select></div></div><div class="column is-6"><label asp-for="StudentId" class="label"></label><div class="select is-fullwidth"><select asp-for="StudentId" asp-items="Model.Students"><option value="">Select a student</option></select></div></div><div class="column is-6"><label asp-for="Email" class="label"></label><input asp-for="Email" class="input"/></div><div class="column is-12"><label asp-for="Address" class="label"></label><input asp-for="Address" class="input"/></div></div><button class="button is-primary" type="submit">Save changes</button> <a asp-action="Index" class="button is-light">Cancel</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
