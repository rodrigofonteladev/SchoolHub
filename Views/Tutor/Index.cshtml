@model IEnumerable<SchoolHub.Models.ViewModels.Tutor.ListTutorViewModel>
<div class="container"><h1 class="title is-2">Tutors</h1><a asp-action="Create" class="button is-primary">Create Tutor</a><div class="table-container mt-5"><table class="table is-fullwidth is-hoverable"><thead><tr><th>Full name</th><th>Type document</th><th>Number document</th><th>Relationship</th><th>Student</th><th>Email</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="7" class="has-text-centered">No tutors found.</td></tr>}else{foreach(var item in Model){<tr><td>@item.FullName @item.PaternalSurname @item.MaternalSurname</td><td>@item.DocumentTypeName</td><td>@item.DocumentNumber</td><td>@item.Relationship</td><td>@item.StudentName</td><td>@item.Email</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="button is-small is-info" title="Edit tutor"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span></a></td></tr>}}</tbody></table></div></div>
