@model SchoolHub.Models.ViewModels.Tutor.RegisterTutorViewModel
<div class="container"><h1 class="title is-2">Tutor Creation Form</h1><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="columns is-multiline"><div class="column is-6"><label asp-for="FullName" class="label"></label><input asp-for="FullName" class="input" /><span asp-validation-for="FullName" class="help is-danger"></span></div><div class="column is-6"><label asp-for="PaternalSurname" class="label"></label><input asp-for="PaternalSurname" class="input" /><span asp-validation-for="PaternalSurname" class="help is-danger"></span></div><div class="column is-6"><label asp-for="MaternalSurname" class="label"></label><input asp-for="MaternalSurname" class="input" /><span asp-validation-for="MaternalSurname" class="help is-danger"></span></div><div class="column is-6"><label asp-for="DocumentNumber" class="label"></label><input asp-for="DocumentNumber" class="input" /><span asp-validation-for="DocumentNumber" class="help is-danger"></span></div><div class="column is-6"><label asp-for="DocumentTypeId" class="label"></label><div class="select is-fullwidth"><select asp-for="DocumentTypeId" asp-items="Model.DocumentTypes"><option value="">Select a document type</option></select></div><span asp-validation-for="DocumentTypeId" class="help is-danger"></span></div><div class="column is-6"><label asp-for="Relationship" class="label"></label><div class="select is-fullwidth"><select asp-for="Relationship" asp-items="Html.GetEnumSelectList<SchoolHub.Common.Enums.TutorType>()"><option value="">Select a relationship</option></select></div><span asp-validation-for="Relationship" class="help is-danger"></span></div><div class="column is-6"><label asp-for="StudentId" class="label"></label><div class="select is-fullwidth"><select asp-for="StudentId" asp-items="Model.Students"><option value="">Select a student</option></select></div><span asp-validation-for="StudentId" class="help is-danger"></span></div><div class="column is-6"><label asp-for="Email" class="label"></label><input asp-for="Email" class="input" /><span asp-validation-for="Email" class="help is-danger"></span></div><div class="column is-12"><label asp-for="Address" class="label"></label><input asp-for="Address" class="input" /><span asp-validation-for="Address" class="help is-danger"></span></div></div><button class="button is-primary" type="submit">Register Tutor</button> <a asp-action="Index" class="button is-light">Back to tutors</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
