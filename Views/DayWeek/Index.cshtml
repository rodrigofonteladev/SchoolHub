@model IEnumerable<SchoolHub.Models.ViewModels.DayWeek.ListDayWeekViewModel>
<div class="container">
    <h1 class="title is-2">Days of the Week</h1>
    <a asp-action="Create" class="button is-primary">Create Day</a>
    <div class="table-container mt-5">
        <table class="table is-fullwidth is-hoverable">
            <thead><tr><th>Name</th><th>Schedules</th><th>Actions</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="has-text-centered">No days found.</td></tr>
                }
                else
                {
                    foreach (var day in Model)
                    {
                        <tr>
                            <td>@day.Name</td>
                            <td>@day.ScheduleCount</td>
                            <td><a asp-action="Edit" asp-route-id="@day.Id" class="button is-small is-info" title="Edit day"><span class="icon"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></span></a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
