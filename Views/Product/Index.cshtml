@model IEnumerable<SchoolHub.Models.ViewModels.Product.ListProductViewModel>
<div class="container"><h1 class="title is-2">Products</h1><a asp-action="Create" class="button is-primary">Create Product</a><div class="table-container mt-5"><table class="table is-fullwidth is-hoverable"><thead><tr><th>Name</th><th>Description</th><th>Price points</th><th>Stock</th><th>Purchases</th><th>Actions</th></tr></thead><tbody>@if (!Model.Any()){<tr><td colspan="6" class="has-text-centered">No products found.</td></tr>}else{foreach(var item in Model){<tr><td>@item.Name</td><td>@item.Description</td><td>@item.PricePoints</td><td>@item.Stock</td><td>@item.PurchaseCount</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="button is-small is-info" title="Edit product"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span></a></td></tr>}}</tbody></table></div></div>
