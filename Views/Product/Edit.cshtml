@model SchoolHub.Models.ViewModels.Product.RegisterProductViewModel
<div class="container"><h1 class="title is-2">Edit Product</h1><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="columns is-multiline"><div class="column is-6"><label asp-for="Name" class="label"></label><input asp-for="Name" class="input"/><span asp-validation-for="Name" class="help is-danger"></span></div><div class="column is-3"><label asp-for="PricePoints" class="label"></label><input asp-for="PricePoints" class="input" type="number" min="0"/><span asp-validation-for="PricePoints" class="help is-danger"></span></div><div class="column is-3"><label asp-for="Stock" class="label"></label><input asp-for="Stock" class="input" type="number" min="0"/><span asp-validation-for="Stock" class="help is-danger"></span></div><div class="column is-12"><label asp-for="Description" class="label"></label><textarea asp-for="Description" class="textarea"></textarea></div></div><button class="button is-primary" type="submit">Save changes</button> <a asp-action="Index" class="button is-light">Cancel</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
