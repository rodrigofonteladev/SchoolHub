@model SchoolHub.Models.ViewModels.Payment.PaymentResultViewModel

<div class="container has-text-centered">
    <h1 class="title is-2">@Model.Title</h1>
    <p class="mb-5">@Model.Message</p>

    @if (!string.IsNullOrWhiteSpace(Model.ExternalReference))
    {
        <p class="mb-5">Reference: <strong>@Model.ExternalReference</strong></p>
    }

    <a asp-controller="Payment" asp-action="Index" class="button is-primary">
        <span class="icon"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></span>
        <span>Back to payments</span>
    </a>
</div>