@model SchoolHub.Models.ViewModels.CategoryCourse.RegisterCategoryCourseViewModel
<div class="container"><h1 class="title is-2">Course Category Creation Form</h1><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="field"><label asp-for="Name" class="label"></label><input asp-for="Name" class="input" /><span asp-validation-for="Name" class="help is-danger"></span></div><div class="field"><label asp-for="Description" class="label"></label><textarea asp-for="Description" class="textarea"></textarea><span asp-validation-for="Description" class="help is-danger"></span></div><button class="button is-primary" type="submit">Register Category</button> <a asp-action="Index" class="button is-light">Back to categories</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
