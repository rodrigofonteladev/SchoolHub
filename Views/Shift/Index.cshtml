@model IEnumerable<SchoolHub.Models.ViewModels.Shift.ListShiftViewModel>
<div class="container"><h1 class="title is-2">Shifts</h1><a asp-action="Create" class="button is-primary">Create Shift</a><div class="table-container mt-5"><table class="table is-fullwidth is-hoverable"><thead><tr><th>Name</th><th>Schedules</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="3" class="has-text-centered">No shifts found.</td></tr>}else{foreach(var item in Model){<tr><td>@item.Name</td><td>@item.ScheduleCount</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="button is-small is-info" title="Edit shift"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span></a></td></tr>}}</tbody></table></div></div>
