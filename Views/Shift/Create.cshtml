@model SchoolHub.Models.ViewModels.Shift.RegisterShiftViewModel
<div class="container"><h1 class="title is-2">Shift Creation Form</h1><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="field"><label asp-for="Name" class="label"></label><input asp-for="Name" class="input" /><span asp-validation-for="Name" class="help is-danger"></span></div><button class="button is-primary" type="submit">Register Shift</button> <a asp-action="Index" class="button is-light">Back to shifts</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
