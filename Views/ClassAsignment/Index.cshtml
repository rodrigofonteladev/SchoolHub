@model IEnumerable<SchoolHub.Models.ViewModels.ClassAsignment.ListClassAsignmentViewModel>
<div class="container"><h1 class="title is-2">Class Assignments</h1><a asp-action="Create" class="button is-primary">Create Class Assignment</a><div class="table-container mt-5"><table class="table is-fullwidth is-hoverable"><thead><tr><th>Year</th><th>Teacher</th><th>Course</th><th>Section</th><th>Schedule</th><th>Ratings</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="7" class="has-text-centered">No class assignments found.</td></tr>}else{foreach(var item in Model){<tr><td>@item.AssignedYear</td><td>@item.TeacherName</td><td>@item.CourseName</td><td>@item.SectionName</td><td>@item.ScheduleDescription</td><td>@item.RatingCount</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="button is-small is-info" title="Edit class assignment"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span></a></td></tr>}}</tbody></table></div></div>
