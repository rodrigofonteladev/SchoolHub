@model SchoolHub.Models.ViewModels.Schedule.RegisterScheduleViewModel
<div class="container"><h1 class="title is-2">Edit Schedule</h1><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="columns"><div class="column"><label asp-for="DayWeekId" class="label"></label><div class="select is-fullwidth"><select asp-for="DayWeekId" asp-items="Model.Days"><option value="">Select a day</option></select></div></div><div class="column"><label asp-for="ShiftId" class="label"></label><div class="select is-fullwidth"><select asp-for="ShiftId" asp-items="Model.Shifts"><option value="">Select a shift</option></select></div></div><div class="column"><label asp-for="StartTime" class="label"></label><input asp-for="StartTime" class="input" type="time"/></div><div class="column"><label asp-for="EndTime" class="label"></label><input asp-for="EndTime" class="input" type="time"/></div></div><button class="button is-primary" type="submit">Save changes</button> <a asp-action="Index" class="button is-light">Cancel</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
