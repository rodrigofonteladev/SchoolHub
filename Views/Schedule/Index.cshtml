@model IEnumerable<SchoolHub.Models.ViewModels.Schedule.ListScheduleViewModel>
<div class="container"><h1 class="title is-2">Schedules</h1><a asp-action="Create" class="button is-primary">Create Schedule</a><div class="table-container mt-5"><table class="table is-fullwidth is-hoverable"><thead><tr><th>Day</th><th>Shift</th><th>Start</th><th>End</th><th>Assignments</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="has-text-centered">No schedules found.</td></tr>}else{foreach(var item in Model){<tr><td>@item.DayWeekName</td><td>@item.ShiftName</td><td>@item.StartTime.ToString("HH:mm")</td><td>@item.EndTime.ToString("HH:mm")</td><td>@item.ClassAssignmentCount</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="button is-small is-info" title="Edit schedule"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span></a></td></tr>}}</tbody></table></div></div>
