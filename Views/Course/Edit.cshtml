@model SchoolHub.Models.ViewModels.Course.RegisterCourseViewModel
<div class="container"><h1 class="title is-2">Edit Course</h1><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><label asp-for="Name" class="label"></label><input asp-for="Name" class="input"/><span asp-validation-for="Name" class="help is-danger"></span><label asp-for="CategoryCourseId" class="label mt-4"></label><div class="select is-fullwidth"><select asp-for="CategoryCourseId" asp-items="Model.Categories"><option value="">Select a category</option></select></div><span asp-validation-for="CategoryCourseId" class="help is-danger"></span><label asp-for="WeeklyHours" class="label mt-4"></label><input asp-for="WeeklyHours" class="input" type="number" min="1" max="40"/><span asp-validation-for="WeeklyHours" class="help is-danger"></span><label asp-for="Description" class="label mt-4"></label><textarea asp-for="Description" class="textarea"></textarea><span asp-validation-for="Description" class="help is-danger"></span><button class="button is-primary mt-4" type="submit">Save changes</button> <a asp-action="Index" class="button is-light mt-4">Cancel</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
