@model SchoolHub.Models.ViewModels.Course.RegisterCourseViewModel
<div class="container"><h1 class="title is-2">Course Creation Form</h1><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="columns is-multiline"><div class="column is-6"><label asp-for="Name" class="label"></label><input asp-for="Name" class="input" /><span asp-validation-for="Name" class="help is-danger"></span></div><div class="column is-6"><label asp-for="CategoryCourseId" class="label"></label><div class="select is-fullwidth"><select asp-for="CategoryCourseId" asp-items="Model.Categories"><option value="">Select a category</option></select></div><span asp-validation-for="CategoryCourseId" class="help is-danger"></span></div><div class="column is-6"><label asp-for="WeeklyHours" class="label"></label><input asp-for="WeeklyHours" class="input" type="number" min="1" max="40" /><span asp-validation-for="WeeklyHours" class="help is-danger"></span></div><div class="column is-12"><label asp-for="Description" class="label"></label><textarea asp-for="Description" class="textarea"></textarea><span asp-validation-for="Description" class="help is-danger"></span></div></div><button class="button is-primary" type="submit">Register Course</button> <a asp-action="Index" class="button is-light">Back to courses</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
