@model IEnumerable<SchoolHub.Models.ViewModels.Course.ListCourseViewModel>
<div class="container"><h1 class="title is-2">Courses</h1><a asp-action="Create" class="button is-primary">Create Course</a><div class="table-container mt-5"><table class="table is-fullwidth is-hoverable"><thead><tr><th>Name</th><th>Category</th><th>Weekly hours</th><th>Assignments</th><th>Actions</th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="5" class="has-text-centered">No courses found.</td></tr> } else { foreach (var course in Model) { <tr><td>@course.Name</td><td>@course.CategoryName</td><td>@course.WeeklyHours</td><td>@course.ClassAssignmentCount</td><td><a asp-action="Edit" asp-route-id="@course.Id" class="button is-small is-info" title="Edit course"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span></a></td></tr> } }</tbody></table></div></div>
