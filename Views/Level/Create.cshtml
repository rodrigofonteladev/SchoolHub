@model SchoolHub.Models.ViewModels.Level.RegisterLevelViewModel

<div class="container">
    <h1 class="title is-2">Level Creation Form</h1>

    <form asp-controller="Level" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div>

        <div class="columns">
            <div class="column is-12-mobile is-6-tablet">
                <div class="field">
                    <label asp-for="Name" class="label"></label>
                    <div class="control">
                        <input asp-for="Name" class="input" placeholder="Level Name" />
                    </div>
                    <span asp-validation-for="Name" class="help is-danger"></span>
                </div>
            </div>
        </div>

        <div class="has-text-centered">
            <button class="button is-primary" type="submit">Register Level</button>
            <a asp-action="Index" class="button is-light">
                <span class="icon"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></span>
                <span>Back to levels</span>
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
