@model SchoolHub.Models.ViewModels.Enrollment.RegisterEnrollmentViewModel
<div class="container"><h1 class="title is-2">Enrollment Creation Form</h1><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="columns is-multiline"><div class="column is-6"><label asp-for="StudentId" class="label"></label><div class="select is-fullwidth"><select asp-for="StudentId" asp-items="Model.Students"><option value="">Select a student</option></select></div><span asp-validation-for="StudentId" class="help is-danger"></span></div><div class="column is-6"><label asp-for="SectionId" class="label"></label><div class="select is-fullwidth"><select asp-for="SectionId" asp-items="Model.Sections"><option value="">Select a section</option></select></div><span asp-validation-for="SectionId" class="help is-danger"></span></div><div class="column is-6"><label asp-for="ReasonEnrollmentId" class="label"></label><div class="select is-fullwidth"><select asp-for="ReasonEnrollmentId" asp-items="Model.Reasons"><option value="">Select a reason</option></select></div><span asp-validation-for="ReasonEnrollmentId" class="help is-danger"></span></div><div class="column is-6"><label asp-for="EnrolledYear" class="label"></label><input asp-for="EnrolledYear" class="input" type="number" /><span asp-validation-for="EnrolledYear" class="help is-danger"></span></div></div><button class="button is-primary" type="submit">Register Enrollment</button> <a asp-action="Index" class="button is-light">Back to enrollments</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
