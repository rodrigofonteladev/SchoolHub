@model SchoolHub.Models.ViewModels.Enrollment.EditEnrollmentViewModel
<div class="container"><h1 class="title is-2">Edit Enrollment</h1><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="field"><label class="label">Student</label><input class="input" value="@Model.StudentName" disabled/></div><div class="columns"><div class="column"><label class="label">Year</label><input class="input" value="@Model.EnrolledYear" disabled/></div><div class="column"><label asp-for="Status" class="label"></label><div class="select is-fullwidth"><select asp-for="Status" asp-items="Html.GetEnumSelectList<SchoolHub.Common.Enums.EnrollmentStatus>()"></select></div></div><div class="column"><label asp-for="SectionId" class="label"></label><div class="select is-fullwidth"><select asp-for="SectionId" asp-items="Model.Sections"><option value="">Select a section</option></select></div></div><div class="column"><label asp-for="ReasonEnrollmentId" class="label"></label><div class="select is-fullwidth"><select asp-for="ReasonEnrollmentId" asp-items="Model.Reasons"><option value="">Select a reason</option></select></div></div></div><button class="button is-primary" type="submit">Save changes</button> <a asp-action="Index" class="button is-light">Cancel</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
