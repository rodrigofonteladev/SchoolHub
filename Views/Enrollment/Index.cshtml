@model IEnumerable<SchoolHub.Models.ViewModels.Enrollment.ListEnrollmentViewModel>
<div class="container"><h1 class="title is-2">Enrollments</h1><a asp-action="Create" class="button is-primary">Create Enrollment</a><div class="table-container mt-5"><table class="table is-fullwidth is-hoverable"><thead><tr><th>Student</th><th>Grade</th><th>Section</th><th>Reason</th><th>Year</th><th>Enrolled at</th><th>Status</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="8" class="has-text-centered">No enrollments found.</td></tr>}else{foreach(var item in Model){<tr><td>@item.StudentName</td><td>@item.GradeName</td><td>@item.SectionName</td><td>@item.Reason</td><td>@item.EnrolledYear</td><td>@item.EnrolledAt.ToString("dd/MM/yyyy")</td><td>@item.Status</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="button is-small is-info" title="Edit enrollment"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span></a></td></tr>}}</tbody></table></div></div>
