@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Contraseña actualizada";
}
<main class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="card shadow-sm" style="max-width: 430px; width: 100%;">
        <div class="card-body p-4 p-md-5 text-center">
            <h1 class="h3 mb-3">Contraseña actualizada</h1>
            <p class="text-muted mb-4">Tu contraseña fue configurada correctamente. Ya puedes iniciar sesión.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Ir al login</a>
        </div>
    </div>
</main>
