@model SchoolHub.Models.ViewModels.Rating.RegisterRatingViewModel
<div class="container"><h1 class="title is-2">Rating Creation Form</h1><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><div class="field"><label asp-for="EnrollmentId" class="label"></label><div class="select is-fullwidth"><select asp-for="EnrollmentId" asp-items="Model.Enrollments"><option value="">Select an enrollment</option></select></div><span asp-validation-for="EnrollmentId" class="help is-danger"></span></div><div class="field"><label asp-for="ClassAsignmentId" class="label"></label><div class="select is-fullwidth"><select asp-for="ClassAsignmentId" asp-items="Model.ClassAsignments"><option value="">Select a class assignment</option></select></div><span asp-validation-for="ClassAsignmentId" class="help is-danger"></span></div><div class="columns"><div class="column"><label asp-for="Exam1" class="label"></label><input asp-for="Exam1" class="input" type="number" min="0" max="20" step="0.1" /><span asp-validation-for="Exam1" class="help is-danger"></span></div><div class="column"><label asp-for="Exam2" class="label"></label><input asp-for="Exam2" class="input" type="number" min="0" max="20" step="0.1" /><span asp-validation-for="Exam2" class="help is-danger"></span></div><div class="column"><label asp-for="Exam3" class="label"></label><input asp-for="Exam3" class="input" type="number" min="0" max="20" step="0.1" /><span asp-validation-for="Exam3" class="help is-danger"></span></div></div><button class="button is-primary" type="submit">Register Rating</button> <a asp-action="Index" class="button is-light">Back to ratings</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
