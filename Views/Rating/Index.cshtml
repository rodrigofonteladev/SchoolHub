@model IEnumerable<SchoolHub.Models.ViewModels.Rating.ListRatingViewModel>
<div class="container"><h1 class="title is-2">Ratings</h1><a asp-action="Create" class="button is-primary">Create Rating</a><div class="table-container mt-5"><table class="table is-fullwidth is-hoverable"><thead><tr><th>Student</th><th>Course</th><th>Teacher</th><th>Year</th><th>Exam 1</th><th>Exam 2</th><th>Exam 3</th><th>Actions</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="8" class="has-text-centered">No ratings found.</td></tr>}else{foreach(var item in Model){<tr><td>@item.StudentName</td><td>@item.CourseName</td><td>@item.TeacherName</td><td>@item.EnrolledYear</td><td>@item.Exam1</td><td>@item.Exam2</td><td>@item.Exam3</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="button is-small is-info" title="Edit rating"><span class="icon"><i class="fa-solid fa-pen-to-square"></i></span></a></td></tr>}}</tbody></table></div></div>
