@model SchoolHub.Models.ViewModels.DocumentType.RegisterDocumentTypeViewModel
<div class="container"><h1 class="title is-2">Edit Document Type</h1><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="help is-danger mb-4"></div><label asp-for="Name" class="label"></label><input asp-for="Name" class="input"/><span asp-validation-for="Name" class="help is-danger"></span><label asp-for="IsActive" class="checkbox mt-4"><input asp-for="IsActive"/> @Html.DisplayNameFor(model => model.IsActive)</label><br/><button class="button is-primary mt-4" type="submit">Save changes</button> <a asp-action="Index" class="button is-light mt-4">Cancel</a></form></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
